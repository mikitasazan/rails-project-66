<% content_for :title do %>
  <%= @repository.full_name %>
<% end %>

<%= link_to t(".check"), repository_checks_path(@repository), data: { turbo_method: :post },
            class: "mb-4 inline-block rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>

<h1 class="mb-4 text-2xl font-bold"><%= @repository.full_name %></h1>

<p><strong class="mr-2"><%= t(".name") %></strong><%= @repository.display_name %></p>
<p><strong class="mr-2"><%= t(".language") %></strong><%= @repository.language %></p>

<p>
  <strong class="mr-2"><%= t(".created_at") %></strong>
  <%= l(@repository.created_at, format: :long) if @repository.created_at %>
</p>

<p>
  <strong class="mr-2"><%= t(".updated_at") %></strong>
  <%= l(@repository.updated_at, format: :long) if @repository.updated_at %>
</p>

<hr class="my-4 border-gray-200">

<% if @checks.any? %>
  <table class="w-full text-left">
    <thead>
      <tr>
        <th scope="col" class="border-b border-gray-200 py-2 font-medium">#</th>
        <th scope="col" class="border-b border-gray-200 py-2 font-medium"><%= t(".state") %></th>
        <th scope="col" class="border-b border-gray-200 py-2 font-medium"><%= t(".check_passed") %></th>
        <th scope="col" class="border-b border-gray-200 py-2 font-medium"><%= t(".created_at") %></th>
      </tr>
    </thead>

    <tbody>
      <% @checks.each do |check| %>
        <tr class="odd:bg-gray-50">
          <td class="border-b border-gray-100 py-2">
            <%= link_to check.id, repository_check_path(@repository, check), class: "text-blue-600 hover:underline" %>
          </td>

          <td class="border-b border-gray-100 py-2"><%= check.aasm.human_state %></td>

          <td class="border-b border-gray-100 py-2"><%= check.passed? %></td>
          <td class="border-b border-gray-100 py-2"><%= l(check.created_at, format: :short) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-gray-500"><%= t(".no_checks_yet") %></p>
<% end %>
