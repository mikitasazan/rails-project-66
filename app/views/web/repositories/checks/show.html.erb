<%= link_to t("web.repositories.checks.show.go_to_repository"), repository_path(@check.repository),
            class: "mb-4 inline-block rounded-md bg-blue-600 px-3.5 py-2.5 font-medium text-white hover:bg-blue-500" %>

<h1 class="mb-4 text-2xl font-bold"><%= t(".title", check_id: @check.id) %></h1>

<table class="w-full text-left">
  <tbody>
    <tr>
      <td class="border-b border-gray-100 py-2"><%= t(".created_at") %></td>
      <td class="border-b border-gray-100 py-2"><%= l(@check.created_at, format: :long) %></td>
    </tr>

    <tr>
      <td class="border-b border-gray-100 py-2"><%= t(".status") %></td>
      <td class="border-b border-gray-100 py-2"><%= @check.aasm.human_state %></td>
    </tr>

    <tr>
      <td class="border-b border-gray-100 py-2"><%= t(".check_passed") %></td>
      <td class="border-b border-gray-100 py-2"><%= @check.passed? %></td>
    </tr>

    <tr>
      <td class="border-b border-gray-100 py-2"><%= t(".issues_count") %></td>
      <td class="border-b border-gray-100 py-2"><%= @check_result[:offense_count] %></td>
    </tr>
  </tbody>
</table>
